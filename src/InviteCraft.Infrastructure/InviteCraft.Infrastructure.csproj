<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>InviteCraft.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for IHttpContextAccessor, health checks and hosted services. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InviteCraft.Application\InviteCraft.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- JWT creation (JsonWebTokenHandler) + bearer validation types shared with the Api. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <!-- The card renderer bundle (built by frontend/scripts/build-renderer.mjs) and its host page, loaded into headless Chromium. -->
    <EmbeddedResource Include="Rendering/Assets/render.html" />
    <EmbeddedResource Include="Rendering/Assets/renderer.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InviteCraft.IntegrationTests" />
  </ItemGroup>
</Project>
