<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InviteCraft.Domain\InviteCraft.Domain.csproj" />
    <ProjectReference Include="..\..\src\InviteCraft.Application\InviteCraft.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (opted in via global.json). -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
