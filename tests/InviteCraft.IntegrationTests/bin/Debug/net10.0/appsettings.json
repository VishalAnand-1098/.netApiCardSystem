{
  "ConnectionStrings": {
    "Default": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 300,
    "AuthPermitPerMinute": 10,
    "PaymentPermitPerMinute": 20
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "EmailVerificationTokenHours": 48,
    "PasswordResetTokenMinutes": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshCookieSecure": true,
    "FrontendBaseUrl": "https://invitecraft.example"
  },
  "Jwt": {
    "Issuer": "InviteCraft",
    "Audience": "InviteCraft.Web",
    "SigningKey": ""
  },
  "Rendering": {
    "BrowserChannel": "chrome",
    "BrowserPath": null,
    "NoSandbox": false,
    "MaxConcurrency": 2,
    "TimeoutSeconds": 45,
    "PrintMarginMm": 8
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/storage",
    "PublicBaseUrl": "/media"
  },
  "Email": {
    "Mode": "Smtp",
    "FromAddress": "no-reply@invitecraft.example",
    "FromName": "InviteCraft",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  }
}
